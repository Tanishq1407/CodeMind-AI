{
  "name": "codemind-ai",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "next dev",
    "build": "prisma generate && next build",
    "build:windows-staged": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-outside-onedrive.ps1",
    "start": "next start",
    "lint": "eslint src e2e scripts prisma/seed.ts next.config.ts eslint.config.mjs playwright.config.ts vitest.config.ts postcss.config.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:generate": "prisma generate",
    "db:migrate": "node scripts/prisma-with-env.mjs migrate deploy",
    "db:dev": "node scripts/prisma-with-env.mjs migrate dev",
    "db:validate": "node scripts/prisma-with-env.mjs validate",
    "db:seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.10.0",
    "@monaco-editor/react": "^4.7.0",
    "@neon/config": "^1.14.0",
    "@neon/env": "^2.1.3",
    "@prisma/client": "6.19.3",
    "acorn": "8.15.0",
    "bcryptjs": "^3.0.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "java-parser": "3.0.1",
    "lucide-react": "^0.468.0",
    "next": "15.5.29",
    "next-auth": "^5.0.0-beta.30",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "^9.0.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@playwright/test": "1.55.0",
    "@tailwindcss/postcss": "^4.1.13",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.18.6",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "eslint": "^9.35.0",
    "eslint-config-next": "^15.5.29",
    "prisma": "6.19.3",
    "tailwindcss": "^4.1.13",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "6.4.5",
    "vitest": "^3.2.4"
  }
}
